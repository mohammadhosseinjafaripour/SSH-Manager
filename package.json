{
  "name": "ssh-vault",
  "productName": "SSH Vault",
  "version": "0.6.4",
  "description": "Secure, minimal SSH connection manager with an encrypted local vault and automatic sudo elevation",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "author": "SSH Vault",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.devui.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --win nsis portable",
    "smoke": "node scripts/smoke-startup.cjs",
    "smoke:instance": "node scripts/smoke-single-instance.cjs",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run audit"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@xterm/addon-search": "^0.16.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "motion": "^14.9.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}
